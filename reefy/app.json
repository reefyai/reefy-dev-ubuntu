{
  "slug": "dev-ubuntu",
  "version": "24.04-2026.06.20-7",
  "name": "Dev Ubuntu",
  "icon": "/static/icons/dev-ubuntu.png",
  "description": "Ubuntu 24.04 development environment with systemd, KVM passthrough, and host /dev",
  "image": "ghcr.io/reefyai/reefy-dev-ubuntu:24.04-2026.06.20-7",
  "releases": [
    "ghcr.io/reefyai/reefy-dev-ubuntu:24.04-2026.06.20-7",
    "ghcr.io/reefyai/reefy-dev-ubuntu:24.04-2026.05.10-6",
    "ghcr.io/reefyai/reefy-dev-ubuntu:24.04-2026.05.09-5",
    "ghcr.io/reefyai/reefy-dev-ubuntu:24.04-2026.04.27-2"
  ],
  "privileged": true,
  "gpu": true,
  "devices": [
    "/dev/kvm"
  ],
  "host_mounts": [
    "/dev:/dev",
    "/sys/fs/cgroup:/sys/fs/cgroup:rw"
  ],
  "tmpfs": [
    "/run",
    "/tmp"
  ],
  "cgroupns": "host",
  "volumes": {
    "home": {
      "mount": "/root",
      "uid": 0,
      "backup": [
        "borgbase"
      ]
    },
    "build": {
      "mount": "/build",
      "uid": 0
    },
    "docker": {
      "mount": "/var/lib/docker",
      "uid": 0
    },
    "containerd": {
      "mount": "/var/lib/containerd",
      "uid": 0
    }
  },
  "env": {
    "SHELL": "/bin/bash"
  },
  "tags": [
    "dev"
  ]
}
